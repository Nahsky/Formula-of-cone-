#include <iostream>
using namespace std;

int main()
{
    float height1, height2, height3, height4, height5;
    float total, average;
    

    cout << "Enter height of player 1: ";
    cin >> height1;

    cout << "Enter height of player 2: ";
    cin >> height2;

    cout << "Enter height of player 3: ";
    cin >> height3;

    cout << "Enter height of player 4: ";
    cin >> height4;

    cout << "Enter height of player 5: ";
    cin >> height5;

    total = height1 + height2 + height3 + height4 + height5;
    average = total / 5;

    cout << "\nTotal height is: " << total << " cm" << endl;
    cout << "Average height is: " << average << " cm" << endl;

    return 0;
}
